<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Microsoft.Extensions.Validation is used via the [ValidatableType] source generator;
         the package analyzer cannot detect source-generator usage and emits NU1510.
         ASP0029 is the experimental-API warning: Microsoft.Extensions.Validation and [ValidatableType]
         are still marked experimental in ASP.NET Core. -->
    <NoWarn>$(NoWarn);NU1510;ASP0029</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Validation" />
    <PackageReference Include="Scrutor" />
  </ItemGroup>

  <ItemGroup>
    <!-- Italian messages, keyed by Error.Code. MSBuild generates the strongly-typed accessor class (public,
         because ErrorMessageResourceType on a validation attribute requires a visible type). -->
    <EmbeddedResource Update="Resources\OperationsMessages.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)OperationsMessages.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Priamus.Trips.Operations.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>OperationsMessages</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Priamus.Trips.Operations.IntegrationTests" />
    <InternalsVisibleTo Include="Priamus.Trips.Operations.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Priamus.Trips.SharedKernel\Priamus.Trips.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\Priamus.Trips.SharedKernel.Http\Priamus.Trips.SharedKernel.Http.csproj" />
    <ProjectReference Include="..\Priamus.Trips.Operations.Contracts\Priamus.Trips.Operations.Contracts.csproj" />
    <ProjectReference Include="..\..\Identity\Priamus.Trips.Identity.Contracts\Priamus.Trips.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Registry\Priamus.Trips.Registry.Contracts\Priamus.Trips.Registry.Contracts.csproj" />
  </ItemGroup>

</Project>
