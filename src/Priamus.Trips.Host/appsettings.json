{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Jwt": {
    "Issuer": "priamus-trips",
    "Audience": "priamus-trips-clients",
    "SigningKey": "DEVELOPMENT-KEY-REPLACE-IN-PRODUCTION-32CHARS",
    "AccessTokenLifetime": "01:00:00",
    "RefreshTokenLifetime": "12:00:00"
  }
}
