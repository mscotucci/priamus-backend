<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Microsoft.Extensions.Validation is used transitively via [ValidatableType] in Identity module.
         The package analyzer emits NU1510 because source-generator usage isn't detected statically.
         Suppressed here per the known-failure note in the Identity feature brief. -->
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Validation" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Priamus.Trips.SharedKernel\Priamus.Trips.SharedKernel.csproj" />
    <ProjectReference Include="..\Modules\Identity\Priamus.Trips.Identity\Priamus.Trips.Identity.csproj" />
    <ProjectReference Include="..\Modules\Registry\Priamus.Trips.Registry\Priamus.Trips.Registry.csproj" />
    <ProjectReference Include="..\Modules\Operations\Priamus.Trips.Operations\Priamus.Trips.Operations.csproj" />
    <ProjectReference Include="..\Modules\BackOffice\Priamus.Trips.BackOffice\Priamus.Trips.BackOffice.csproj" />
  </ItemGroup>

</Project>
