<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML doc warnings are noisy in early scaffolding; relaxed here to avoid CWE in skeleton phase. -->
    <!-- CS1591: Missing XML comment on publicly visible types/members. -->
    <!-- CS1574: XML cref attribute could not be resolved. -->
    <!-- CS1570: XML comment has badly formed XML. -->
    <NoWarn>$(NoWarn);CS1591;CS1574;CS1570</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
